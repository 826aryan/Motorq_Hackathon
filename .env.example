# Copy to .env and fill in. .env is git-ignored; never commit real values.
POSTGRES_USER=asset
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asset_recovery
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

TIMESCALE_USER=asset
TIMESCALE_PASSWORD=change-me
TIMESCALE_DB=telemetry
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432

REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_PARTITIONS=12
# 6 h: at 100k vehicles Kafka takes ~1.5 MB/s; history lives in Timescale/Parquet
KAFKA_RETENTION_MS=21600000

# Stream pipeline workers; 3 keep up with 100k vehicles incl. bursts
PIPELINE_REPLICAS=3
DETECTOR_REPLICAS=3

# Host ports for local tools (change if another project already uses them)
POSTGRES_HOST_PORT=15432
TIMESCALE_HOST_PORT=15433
REDIS_HOST_PORT=16379

# API auth and privacy (generate your own values)
JWT_SECRET=change-me
DEMO_PASSWORD=change-me
# partner_name:api_key pairs for GET /share/insights, comma-separated
PARTNER_KEYS=insurer-demo:change-me
# base for per-partner HMAC pseudonym keys
PSEUDONYM_SECRET=change-me
